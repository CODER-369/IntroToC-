#include<stdio.h>
int main(){
    int  a, b, add, sub, mul, modulus;
    float  division;
    printf("Enter first number: ");
    scanf("%d", &a);
    printf("Enter second number: ");
    scanf("%d", &b); 
    add = a + b;
    printf("Sum: %d", add); 
    sub = a - b;
    printf("Difference: %d", sub); 
    mul = a * b;
    printf("Product: %d", mul); 
    division = (float)a / b;
    printf("Quotient: %f", division); 
    modulus = a % b;
    printf("Modulus: %d", modulus);
    return 0;
}
