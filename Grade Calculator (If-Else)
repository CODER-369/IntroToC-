#include <stdio.h>
int main(){
    int  percent;
    printf("Enter percent: ");
    scanf("%d", &percent);
    if(percent > 100){
        printf("Invalid marks entered."); 
    } 
    else if(percent >= 90){
        printf("Grade: A+"); 
    } 
    else if(percent >= 80){
        printf("Grade: A"); 
    } 
    else if(percent >= 70){
        printf("Grade: B"); 
    } 
    else if(percent >= 60){
        printf("Grade: C"); 
    } 
    else if(percent >= 50){
        printf("Grade: D"); 
    } 
    else{
        printf("Grade: F (Fail)"); 
    }
    return 0;
}
